{
  "name": "ugultu",
  "private": true,
  "version": "1.0.0",
  "description": "UĞULTU — mobile-first third-person survival horror built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/playtest.mjs",
    "cap:sync": "npm run build && cap sync",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.170.0",
    "meshoptimizer": "^1.3.0",
    "obj2gltf": "^3.2.0",
    "sharp": "^0.35.5",
    "typescript": "5.6",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=22"
  }
}
